{
  "name": "coffee-chain-mvc",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {"node": ">=22.12.0"}
}
